{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/compile.js": {
      "maxDuration": 60
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    }
  ]
}
